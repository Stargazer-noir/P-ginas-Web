{%- comment -%} Global AJAX cart drawer, rendered once in theme.liquid {%- endcomment -%}
<div class="cart-drawer__overlay" data-cart-drawer-overlay data-cart-drawer-close></div>
<aside class="cart-drawer" data-cart-drawer aria-label="{{ 'cart.general.title' | t }}" aria-hidden="true">
  <div class="cart-drawer__header">
    <h2>{{ 'cart.general.title' | t }}</h2>
    <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
  </div>

  <div class="cart-drawer__items" data-cart-items></div>

  <div class="cart-drawer__empty" data-cart-empty hidden>
    <p>{{ 'cart.general.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="button button--dark" data-cart-drawer-close>
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>

  <div class="cart-drawer__footer" data-cart-footer hidden>
    <div class="cart-drawer__subtotal">
      <span>{{ 'cart.general.subtotal' | t }}</span>
      <span data-cart-subtotal>{{ cart.total_price | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="button button--primary button--full">
      {{ 'cart.general.checkout' | t }}
    </a>
  </div>
</aside>
