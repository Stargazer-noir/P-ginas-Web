{%- comment -%}
  Renders a product/variant price with compare-at support.
  Accepts: target (product or variant object)
{%- endcomment -%}
{%- liquid
  assign price = target.price | default: product.price
  assign compare_at = target.compare_at_price | default: product.compare_at_price
-%}
<span class="price">
  {%- if compare_at > price -%}
    <span class="price__sale">{{ price | money }}</span>
    <span class="price__compare">{{ compare_at | money }}</span>
  {%- else -%}
    <span>{{ price | money }}</span>
  {%- endif -%}
</span>
