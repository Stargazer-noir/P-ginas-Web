{%- comment -%}
  Product tile with a real, working "quick add to cart" button — used by
  the product-showcase section. Unlike snippets/product-card.liquid (a
  plain link, used in simple grids), this one submits straight to the
  cart via the same AJAX handler as the product page.
  Accepts: card_product (product object)
{%- endcomment -%}
{%- assign quick_variant = card_product.selected_or_first_available_variant -%}
<div class="product-card">
  <a href="{{ card_product.url }}" class="product-card__media-link" aria-label="{{ card_product.title }}">
    <div class="product-card__media">
      {%- if card_product.featured_media -%}
        <img
          src="{{ card_product.featured_media | image_url: width: 600 }}"
          alt="{{ card_product.featured_media.alt | escape }}"
          loading="lazy"
          width="600"
          height="{{ 600 | divided_by: card_product.featured_media.aspect_ratio | default: 750 }}"
        >
      {%- else -%}
        {%- render 'placeholder-art', id: card_product.id -%}
      {%- endif -%}

      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif card_product.available == false -%}
        <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__body">
    {%- if card_product.vendor -%}
      <span class="product-card__vendor">{{ card_product.vendor }}</span>
    {%- endif -%}
    <a href="{{ card_product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ card_product.title }}</h3>
    </a>
    <div class="product-card__price">
      {%- render 'price', target: card_product -%}
    </div>

    {%- if card_product.available == false -%}
      <button type="button" class="button button--dark product-card__quick-add" disabled>
        {{ 'products.product.sold_out' | t }}
      </button>
    {%- elsif card_product.has_only_default_variant -%}
      {%- form 'product', card_product, data-product-form: true -%}
        <input type="hidden" name="id" value="{{ quick_variant.id }}">
        <button type="submit" class="button button--primary product-card__quick-add" data-loading-text="…">
          {{ 'products.product.add_to_cart' | t }}
        </button>
      {%- endform -%}
    {%- else -%}
      <a href="{{ card_product.url }}" class="button button--dark product-card__quick-add">
        {{ 'products.product.choose_options' | t }}
      </a>
    {%- endif -%}
  </div>
</div>
