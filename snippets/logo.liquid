{%- comment -%}
  Site logo: uses uploaded settings.logo image when present,
  otherwise falls back to a trident icon + serif wordmark.
  Accepts: class (string, optional extra class on wrapper)
{%- endcomment -%}
<span class="site-header__logo {{ class }}">
  {%- if settings.logo -%}
    <img
      src="{{ settings.logo | image_url: width: 600 }}"
      alt="{{ shop.name }}"
      width="{{ settings.logo_width }}"
      height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | default: 60 }}"
      loading="lazy"
    >
  {%- else -%}
    {%- render 'icon-trident', class: 'site-header__logo-icon' -%}
    <span class="site-header__wordmark">{{ shop.name | default: 'Emporeon' }}</span>
  {%- endif -%}
</span>
