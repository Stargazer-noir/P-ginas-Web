<section class="section-padding">
  <div class="page-width">
    <div class="collection-header">
      <span class="eyebrow">{{ 'sections.featured_collection.view_all' | t }}</span>
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rich-text" style="margin-top:0.75rem;">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid grid-cols-{{ section.settings.columns }}">
          {%- for card_product in collection.products -%}
            {%- render 'product-card', card_product: card_product -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p style="text-align:center; padding: 3rem 0; color: var(--color-text-light);">
          {{ 'collections.general.no_matches' | t }}
        </p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav style="display:flex; justify-content:center; gap:0.75rem; margin-top:3rem;" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="button button--dark">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="button button--dark" style="opacity:0.7;">{{ part.title }}</a>
            {%- else -%}
              <span class="button button--primary">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="button button--dark">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Cuadrícula de colección",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 16 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas (escritorio)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ]
}
{% endschema %}
