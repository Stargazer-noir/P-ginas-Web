<section class="section-padding" style="text-align:center; background: var(--color-navy-dark); color:#fff; min-height: 60vh; display:flex; flex-direction:column; justify-content:center;">
  <div class="page-width">
    <h1 style="color:#fff;">{{ shop.name }}</h1>
    <p style="color:rgba(255,255,255,0.75); max-width:480px; margin:0 auto 2rem;">
      {{ shop.password_message | default: 'Estamos preparando algo excepcional. Vuelve pronto.' }}
    </p>

    {%- form 'storefront_password' -%}
      <div style="display:flex; max-width:380px; margin:0 auto; gap:0.6rem;">
        <input type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" style="flex:1; padding:0.85em 1.1em; border:1px solid rgba(255,255,255,0.3); background:transparent; color:#fff; border-radius:2px;">
        <button type="submit" class="button button--primary">{{ 'general.password_page.login_form_submit' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p style="color: var(--color-gold-light); margin-top:1rem;">{{ 'general.password_page.login_form_error' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <p style="margin-top:2rem; font-size:0.8rem; color:rgba(255,255,255,0.5);">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Pie (contraseña)"
}
{% endschema %}
