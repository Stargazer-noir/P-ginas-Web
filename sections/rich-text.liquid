<section class="section-padding">
  <div class="page-width rich-text">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div>{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button button--dark" style="margin-top:1.5rem;">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto enriquecido",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Texto enriquecido" }
  ]
}
{% endschema %}
