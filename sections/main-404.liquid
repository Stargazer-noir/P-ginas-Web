<section class="error-page page-width">
  {%- render 'icon-trident', class: 'error-page__icon', id: '404' -%}
  <h1>{{ 'general.404.title' | t }}</h1>
  <p style="color:var(--color-text-light); max-width:420px; margin:0 auto 2rem;">{{ 'general.404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="button button--dark">{{ 'general.404.link' | t }}</a>
</section>

{% schema %}
{
  "name": "Página 404"
}
{% endschema %}
