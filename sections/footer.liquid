<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        {%- render 'logo', id: 'footer' -%}
        <p>{{ section.settings.brand_text }}</p>
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram">{%- render 'icon-instagram' -%}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook">{%- render 'icon-facebook' -%}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok">{%- render 'icon-tiktok' -%}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div>
        <h3 class="site-footer__heading">{{ 'sections.footer.newsletter_heading' | t }}</h3>
        {%- form 'customer', id: 'FooterNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex; gap:0.5rem;">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              required
              style="flex:1; padding:0.6em; border-radius:2px; border:1px solid rgba(255,255,255,0.3); background:transparent; color:#fff;"
            >
            <button type="submit" class="button button--primary">{{ 'general.newsletter.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="color: var(--color-gold); margin-top:0.75rem; font-size:0.8rem;">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="footer-seal">
        {%- render 'icon-badge' -%}
        {{ 'sections.footer.certified' | t }}
      </div>

      <div class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon' }}
        {%- endfor -%}
      </div>
    </div>

    <p class="copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Texto de marca",
      "default": "Té de origen único para una vida de estatus y bienestar."
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Texto de derechos",
      "default": "Todos los derechos reservados."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Lista de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Enlaces" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ]
}
{% endschema %}
