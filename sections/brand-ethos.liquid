<section class="ethos {% if section.settings.layout == 'reverse' %}ethos--reverse{% endif %} {% if section.settings.style == 'dark' %}ethos--dark{% endif %}">
  <div class="ethos__media">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
    {%- else -%}
      {%- render 'placeholder-art', id: section.id -%}
    {%- endif -%}
  </div>
  <div class="ethos__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary" style="margin-top:1rem;">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ethos de marca",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo de fondo",
      "options": [
        { "value": "dark", "label": "Azul noche (recomendado)" },
        { "value": "light", "label": "Claro" }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición de la imagen",
      "options": [
        { "value": "default", "label": "Izquierda" },
        { "value": "reverse", "label": "Derecha" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "El Ethos Emporeon" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Un Estilo de Vida de Salud Inquebrantable y Exclusividad" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Cada hoja se selecciona a mano en altitudes donde el aire es puro y el terreno, incomparable. No es solo té: es un ritual diario de disciplina y distinción." },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Ethos de marca" }
  ]
}
{% endschema %}
