{%- comment -%}
  Editable hero slideshow. Each slide is a block, so merchants can add,
  remove and reorder slides from the theme editor without touching code.
  Reuses the same .hero__* classes as the static hero section so slides
  look identical to it, just inside a sliding track.
{%- endcomment -%}
<section
  class="hero hero-slider"
  id="HeroSlider-{{ section.id }}"
  data-hero-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="hero-slider__track" data-hero-slider-track>
    {%- for block in section.blocks -%}
      <div class="hero__media hero-slider__slide" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 1800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% if forloop.first %}fetchpriority="high"{% endif %}
            width="1800"
            height="{{ 1800 | divided_by: block.settings.image.aspect_ratio }}"
          >
        {%- else -%}
          {%- render 'placeholder-art', id: block.id -%}
        {%- endif -%}
        <div class="hero__scrim"></div>

        <div class="hero__content">
          {%- if block.settings.eyebrow != blank -%}
            <span class="hero__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="hero__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="hero__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="button button--primary">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-hero-slider-prev aria-label="Diapositiva anterior">
        <svg class="icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-hero-slider-next aria-label="Siguiente diapositiva">
        <svg class="icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}

    {%- if section.settings.show_dots -%}
      <div class="hero-slider__dots" data-hero-slider-dots>
        {%- for block in section.blocks -%}
          <button type="button" class="hero-slider__dot{% if forloop.first %} is-active{% endif %}" data-hero-slider-dot data-index="{{ forloop.index0 }}" aria-label="Ir a la diapositiva {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('HeroSlider-{{ section.id }}');
    if (!root || root.dataset.sliderInit) return;
    root.dataset.sliderInit = 'true';

    var track = root.querySelector('[data-hero-slider-track]');
    var slides = root.querySelectorAll('.hero-slider__slide');
    var dots = root.querySelectorAll('[data-hero-slider-dot]');
    var total = slides.length;
    var current = 0;
    var timer = null;

    if (total <= 1) return;

    function goTo(index) {
      current = (index + total) % total;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === current);
      });
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAutoplay() {
      if (root.dataset.autoplay !== 'true') return;
      var speed = parseInt(root.dataset.autoplaySpeed, 10) || 6000;
      stopAutoplay();
      timer = setInterval(next, speed);
    }

    function stopAutoplay() {
      if (timer) clearInterval(timer);
    }

    var nextBtn = root.querySelector('[data-hero-slider-next]');
    var prevBtn = root.querySelector('[data-hero-slider-prev]');
    if (nextBtn) nextBtn.addEventListener('click', function () { next(); startAutoplay(); });
    if (prevBtn) prevBtn.addEventListener('click', function () { prev(); startAutoplay(); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.dataset.index, 10) || 0);
        startAutoplay();
      });
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Hero (slideshow)",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Avance automático", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Segundos por diapositiva", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar flechas", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar puntos", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
        { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior" },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "button_label", "label": "Texto del botón" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (slideshow)",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Colección de Origen Único",
            "heading": "Emporeon. El Arte del Estatus Puro.",
            "text": "Descubre tu ritual: productos de alta calidad, cosechados y certificados para quienes exigen lo excepcional.",
            "button_label": "Comprar Ahora"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Compra con Confianza",
            "heading": "Envío Confiable y Asegurado",
            "text": "Cada pedido viaja asegurado y con seguimiento en tiempo real, desde nuestra bodega hasta tu puerta.",
            "button_label": "Ver Políticas de Envío"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Para Cada Ritual",
            "heading": "Descubre Toda Nuestra Variedad",
            "text": "Orígenes, intensidades y presentaciones distintas para cada momento del día.",
            "button_label": "Explorar Colección"
          }
        }
      ]
    }
  ]
}
{% endschema %}
