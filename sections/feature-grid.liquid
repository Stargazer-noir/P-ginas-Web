<section class="section-padding section-dark" style="background: var(--color-navy);">
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="feature-grid">
      {%- for block in section.blocks -%}
        <div class="feature-card" {{ block.shopify_attributes }}>
          <div class="feature-card__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- else -%}
              {%- render 'placeholder-art', id: block.id -%}
            {%- endif -%}
          </div>
          <div>
            <span class="feature-card__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <p class="feature-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cuadrícula de ingredientes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Composición" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Ingredientes Estudiados" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Ingrediente",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "L-Teanina" },
        { "type": "text", "id": "text", "label": "Descripción breve", "default": "Calma y enfoque sin somnolencia." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cuadrícula de ingredientes",
      "blocks": [
        { "type": "feature", "settings": { "title": "L-Teanina", "text": "Calma y enfoque sin somnolencia." } },
        { "type": "feature", "settings": { "title": "Catequinas", "text": "Antioxidantes de hoja entera." } },
        { "type": "feature", "settings": { "title": "Minerales de Altura", "text": "Absorbidos del suelo volcánico." } },
        { "type": "feature", "settings": { "title": "Polifenoles", "text": "Apoyo metabólico natural." } }
      ]
    }
  ]
}
{% endschema %}
