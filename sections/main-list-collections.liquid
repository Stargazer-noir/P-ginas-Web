<section class="collection-banner">
  <div class="page-width">
    <div class="collection-header">
      <h1>{{ 'sections.featured_collection.view_all' | t }}</h1>
    </div>
  </div>
</section>

<section class="section-padding">
  <div class="page-width">
    <div class="product-grid grid-cols-3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="product-card">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy">
            {%- else -%}
              {%- render 'placeholder-art', id: collection.id -%}
            {%- endif -%}
          </div>
          <div class="product-card__body">
            <h3 class="product-card__title">{{ collection.title }}</h3>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones"
}
{% endschema %}
