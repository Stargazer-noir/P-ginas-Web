<section class="stats section-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        <h2 style="color:#fff;">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="stats__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div class="stat__value">{{ block.settings.value }}</div>
          <div class="stat__label">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.disclaimer != blank -%}
      <p style="text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5); margin-top:2rem;">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Estadísticas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "text", "id": "disclaimer", "label": "Nota al pie", "default": "*Basado en una muestra de 1,000 clientes." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "98%" },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Clientes que repiten su compra" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Estadísticas",
      "blocks": [
        { "type": "stat", "settings": { "value": "98%", "label": "Clientes que repiten su compra" } },
        { "type": "stat", "settings": { "value": "4.9/5", "label": "Calificación promedio" } },
        { "type": "stat", "settings": { "value": "30+", "label": "Países con envío asegurado" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Origen certificado" } }
      ]
    }
  ]
}
{% endschema %}
