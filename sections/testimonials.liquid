<section class="testimonials section-padding">
  <div class="page-width">
    <div class="section-heading">
      <h2>{{ section.settings.heading | default: 'sections.testimonials.heading' | t }}</h2>
    </div>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </div>
          <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="testimonial-card__author">{{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Por Qué Nuestro Círculo Confía en Emporeon" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "range", "id": "rating", "label": "Calificación", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Cita", "default": "La calidad y atención al detalle son incomparables. Este ritual se volvió parte de mi rutina diaria." },
        { "type": "text", "id": "author", "label": "Autor", "default": "Cliente Verificado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonios",
      "blocks": [
        { "type": "testimonial", "settings": { "rating": 5, "quote": "La calidad y atención al detalle son incomparables. Este ritual se volvió parte de mi rutina diaria.", "author": "A. Johnson" } },
        { "type": "testimonial", "settings": { "rating": 5, "quote": "Se nota el origen. Un sabor y una claridad mental que no había encontrado antes.", "author": "M. Reyes" } },
        { "type": "testimonial", "settings": { "rating": 5, "quote": "El empaque, el aroma, el servicio: todo se siente exclusivo.", "author": "C. Duarte" } }
      ]
    }
  ]
}
{% endschema %}
