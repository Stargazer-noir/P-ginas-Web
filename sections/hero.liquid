<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1800"
        height="{{ 1800 | divided_by: section.settings.image.aspect_ratio }}"
      >
    {%- else -%}
      {%- render 'placeholder-art', id: section.id -%}
    {%- endif -%}
    <div class="hero__scrim"></div>

    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__heading">{{ section.settings.heading | default: 'sections.hero.default_heading' | t }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Colección de Origen Único" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Emporeon. El Arte del Estatus Puro." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Descubre tu ritual: té de alta montaña, cosechado y certificado para quienes exigen lo excepcional." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar Ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
