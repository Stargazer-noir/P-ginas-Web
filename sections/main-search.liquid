<section class="section-padding">
  <div class="page-width">
    <div class="collection-header">
      <h1>{{ 'general.search.search' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:420px; margin:1.5rem auto 0; display:flex; gap:0.5rem;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" style="flex:1; padding:0.75em 1em; border:1px solid #d7d3c8; border-radius:2px;">
        <button type="submit" class="button button--dark">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p style="text-align:center; color:var(--color-text-light); margin-bottom:2rem;">
          {%- if search.results_count == 1 -%}
            {{ 'general.search.results_with_count.one' | t: count: search.results_count }}
          {%- else -%}
            {{ 'general.search.results_with_count.other' | t: count: search.results_count }}
          {%- endif -%}
        </p>
        <div class="product-grid grid-cols-4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', card_product: item -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p style="text-align:center; color:var(--color-text-light);">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Resultados de búsqueda"
}
{% endschema %}
