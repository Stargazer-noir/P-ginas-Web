[
  {
    "name": "theme_info",
    "theme_name": "Emporeon",
    "theme_version": "1.0.0",
    "theme_author": "Emporeon",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "t:settings.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Recomendado: 400 x 120px, fondo transparente (.png o .svg)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Ancho del logo",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Se mostrará a 32 x 32px"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "header",
        "content": "Paleta Emporeon"
      },
      {
        "type": "paragraph",
        "content": "Paleta oficial: blanco, negro y azul oscuro como base, con el dorado del tridente reservado para el logo y acentos puntuales (botones, íconos, líneas)."
      },
      {
        "type": "color",
        "id": "color_black",
        "label": "Negro (encabezado / pie de página)",
        "default": "#0B0C0F"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Azul oscuro (secciones de acento)",
        "default": "#0F1F3A"
      },
      {
        "type": "color",
        "id": "color_navy_dark",
        "label": "Azul negro (degradados / fondos profundos)",
        "default": "#060A12"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Dorado (logo y acentos)",
        "default": "#C9A227"
      },
      {
        "type": "color",
        "id": "color_gold_light",
        "label": "Dorado claro",
        "default": "#E7C766"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Fondo principal (blanco)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_bg_secondary",
        "label": "Fondo secundario (gris azulado claro)",
        "default": "#EEF1F6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto principal (negro)",
        "default": "#111214"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Texto secundario (gris)",
        "default": "#5B6270"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "header",
        "content": "Encabezados"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Fuente de encabezados",
        "default": "playfair-display_n7"
      },
      {
        "type": "header",
        "content": "Texto de cuerpo"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fuente de cuerpo",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Ancho máximo de página",
        "default": 1280
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://instagram.com"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "default": "https://facebook.com"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "default": "https://tiktok.com"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Tipo de carrito",
        "options": [
          { "value": "drawer", "label": "Panel lateral" },
          { "value": "page", "label": "Página" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permitir nota de pedido",
        "default": true
      }
    ]
  }
]
